PORT=5000
NODE_ENV=production

# Hosted MySQL connection
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-mysql-user
DB_PASSWORD=your-mysql-password
DB_NAME=habit_tracker_db

# Generate a unique random value with at least 32 characters
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated frontend origins. Leave empty when frontend is served by this backend.
CLIENT_ORIGIN=
